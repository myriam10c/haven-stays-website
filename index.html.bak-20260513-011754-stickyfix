}

/* ============================================================
   RESPONSIVE
   ============================================================ */

/* Palier intermédiaire — laptop étroit / iPad paysage : la frise zigzag 7 col devient illisible sous 1280px, on bascule vertical avant */
@media (max-width: 1280px) and (min-width: 1021px) {
  .timeline-step h3 { font-size: 1.2rem; }
  .timeline-step p { font-size: 0.82rem; }
}

@media (max-width: 1020px) {
  .page-inner { padding: 0 1.8rem; }
  .page { padding: 4rem 0; min-height: auto; }
  .operator-grid { grid-template-columns: 1fr; gap: 3rem; }
  .operator-portrait { aspect-ratio: 3 / 4; max-width: 460px; }
  .operator-cv { grid-template-columns: 1fr 1fr; }
  .portfolio { flex-direction: column; min-height: auto; }
  .portfolio-image { flex: 0 0 320px; }
  .portfolio-image::after {
    background: linear-gradient(180deg, transparent 0%, transparent 60%, var(--ink-deep) 100%);
  }
  .portfolio-content { padding: 2.5rem 1.8rem; }
  .record-grid { grid-template-columns: 1fr; }
  .record-stat { border-right: 0; border-bottom: 1px solid var(--rule); min-height: auto; padding: 2.5rem 0; }
  .record-stat:last-child { border-bottom: 0; }
  .charter-grid { grid-template-columns: 1fr; gap: 2rem; }
  .charter-aside { position: static; }
  .projection-grid { grid-template-columns: 1fr; gap: 2.5rem; }
  .projection-aside { position: static; padding-right: 0; }
  .timeline { padding: 2rem 0; }
  .timeline-track { grid-template-columns: 1fr; gap: 2.2rem; }
  .timeline-track::before {
    top: 0; bottom: 0; left: 19px; right: auto;
    width: 1px; height: auto;
    transform: none;
  }
  .timeline-step {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    text-align: left;
    gap: 1.2rem;
    padding: 0;
    min-height: 0;
  }
  /* Force le node à gauche sur la ligne verticale, peu importe l'ordre HTML (qui alterne pour le zigzag desktop) */
  .timeline-step .node {
    flex: 0 0 38px;
    margin-top: 0.2rem;
    order: -1;
  }
