}
.colophon .ours-brand {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}
.colophon .ours-brand .mark {
  font-family: var(--display);
  font-size: 1.6rem;
  letter-spacing: 0;
  color: var(--cream);
  text-transform: none;
  line-height: 1;
}
.colophon .ours-brand .ours-tagline {
  font-family: var(--serif);
  font-size: 0.85rem;
  letter-spacing: 0;
  text-transform: none;
  color: rgba(244, 239, 227, 0.78);
  line-height: 1.5;
  max-width: 36ch;
}
.colophon .ours-brand .ours-locations {
  color: var(--terra);
  font-size: 0.65rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  margin-top: 0.5rem;
}
.colophon .ours-col h4 {
  font-family: var(--mono);
  font-size: 0.62rem;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--cream);
  font-weight: 500;
  margin-bottom: 1rem;
}
.colophon .ours-col ul {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
}
.colophon .ours-col li {
  font-family: var(--serif);
  font-size: 0.92rem;
  letter-spacing: 0;
  text-transform: none;
