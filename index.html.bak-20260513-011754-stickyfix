}
.portfolio-index .count {
  font-family: var(--mono);
  font-size: 0.7rem;
  letter-spacing: 0.18em;
  color: rgba(244, 239, 227, 0.5);
}

.portfolio-foot {
  margin-top: 2.5rem;
  padding-top: 1rem;
  border-top: 1px solid rgba(244, 239, 227, 0.2);
  display: flex;
  justify-content: space-between;
  font-family: var(--mono);
  font-size: 0.62rem;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: rgba(244, 239, 227, 0.55);
}

/* ============================================================
   PAGE 06 — TRACK RECORD (Chiffres typographiques)
   ============================================================ */

.record {
  background: var(--paper);
}
.record .page-head h2 { font-size: 1.1rem; font-family: var(--serif); font-weight: 400; }
.record-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0;
  border-top: 1px solid var(--ink);
  border-bottom: 1px solid var(--ink);
  flex: 1;
}
.record-stat {
  padding: 4rem 2.5rem;
  border-right: 1px solid var(--rule);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 360px;
}
.record-stat:last-child { border-right: 0; }
.record-stat .label {
  font-family: var(--serif);
  font-style: normal;
  font-size: 1.05rem;
  color: var(--mute);
  line-height: 1.4;
  max-width: 20ch;
}
.record-stat .figure {
  font-family: var(--display);
  font-size: clamp(5rem, 11vw, 11rem);
  line-height: 0.9;
  margin: 1.5rem 0;
  color: var(--ink);
}
.record-stat .figure .unit {
  font-family: var(--serif);
  font-style: normal;
  font-size: 0.35em;
  color: var(--terra);
  vertical-align: middle;
  margin-left: 0.2em;
  font-weight: 400;
}
.record-stat .note {
  font-family: var(--mono);
  font-size: 0.62rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--mute);
  line-height: 1.6;
}

/* ============================================================
   PAGE ONBOARDING — Frise 7 jours en zigzag (haut/bas alternés)
   ============================================================ */

.onboarding { background: var(--paper); }
.onboarding .onboarding-head {
  text-align: center;
  max-width: 720px;
  margin: 0 auto 1.5rem;
}
.onboarding-head h2 {
  font-size: clamp(2.2rem, 4.4vw, 3.8rem);
  line-height: 1.05;
  margin-top: 0.6rem;
}
.onboarding-head p {
  font-family: var(--serif);
  font-size: 1.05rem;
  line-height: 1.55;
  color: var(--ink);
  opacity: 0.82;
  max-width: 56ch;
  margin: 1rem auto 0;
}

.timeline {
  position: relative;
  padding: 0.5rem 0 0;
}
.timeline-track {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  position: relative;
  gap: 0;
}
/* Ligne horizontale centrale qui relie tous les nœuds */
.timeline-track::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 7%;
  right: 7%;
  height: 1px;
  background: var(--ink);
  transform: translateY(-0.5px);
  z-index: 0;
}

.timeline-step {
  position: relative;
  display: grid;
  grid-template-rows: 1fr auto 1fr;
  align-items: center;
  justify-items: center;
  min-height: 280px;
  padding: 0 0.5rem;
  z-index: 1;
}

/* Le node circulaire reste au centre, sur la ligne horizontale */
.timeline-step .node {
  grid-row: 2;
  width: 38px; height: 38px;
  border: 1px solid var(--ink);
  background: var(--paper);
  border-radius: 50%;
  transition: all 0.25s;
}
.timeline-step:hover .node {
  background: var(--terra);
  border-color: var(--terra);
  transform: scale(1.1);
}

/* Bloc de contenu (jour + label + titre + note) */
.timeline-step .step-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 0.5rem;
  max-width: 22ch;
}

/* Étapes IMPAIRES (1, 3, 5, 7) : contenu AU-DESSUS du node */
.timeline-step:nth-child(odd) .step-block {
  grid-row: 1;
  align-self: end;
  padding-bottom: 1.2rem;
}
/* Étapes PAIRES (2, 4, 6) : contenu EN DESSOUS du node */
.timeline-step:nth-child(even) .step-block {
  grid-row: 3;
  align-self: start;
  padding-top: 1.2rem;
}

.timeline-step .day {
  font-family: var(--mono);
  font-size: 0.66rem;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--terra);
}
.timeline-step h3 {
  font-family: var(--display);
  font-size: 1.45rem;
  line-height: 1.05;
  margin: 0.3rem 0 0.4rem;
}
.timeline-step p {
  font-family: var(--serif);
  font-size: 0.95rem;
  color: var(--ink);
  opacity: 0.82;
  line-height: 1.45;
  margin: 0;
}

.timeline-foot {
  margin-top: 1.5rem;
  padding-top: 1.2rem;
  border-top: 1px solid var(--rule-soft);
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  font-family: var(--mono);
  font-size: 0.7rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--ink);
  opacity: 0.7;
}
.timeline-foot strong {
  font-family: var(--display);
  font-size: 1.3rem;
  font-weight: 400;
  color: var(--ink);
  letter-spacing: 0;
  text-transform: none;
}

/* ============================================================
   PAGE TÉMOIN — Vidéo Mamadou Sakho
   ============================================================ */

.witness {
  background: var(--ink-deep);
  color: var(--cream);
}
.witness .page-head { border-color: rgba(244,239,227,0.2); }
.witness .section-label { color: rgba(244,239,227,0.6); }
.witness .folio { color: rgba(244,239,227,0.45); }

.witness-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
  gap: 3rem;
  align-items: center;
}

.witness-video {
  position: relative;
  width: 100%;
  max-width: 100%;
  aspect-ratio: 16 / 9;
  background: var(--ink-soft);
  overflow: hidden;
  border: 1px solid rgba(244,239,227,0.15);
  min-width: 0;
}
.witness-video iframe,
.witness-video video {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  border: 0;
  display: block;
  background: var(--ink-deep);
}
.witness-video::after {
  content: '';
  position: absolute;
  inset: 0;
  border: 1px solid rgba(244,239,227,0.06);
  outline: 1px solid rgba(244,239,227,0.06);
  outline-offset: -10px;
  pointer-events: none;
}

.witness-text {
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.witness-text .kicker {
  font-family: var(--mono);
  font-size: 0.65rem;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--terra);
  margin-bottom: 1rem;
}
.witness-text h2 {
  font-family: var(--display);
  font-size: clamp(2.2rem, 4vw, 3.4rem);
  line-height: 1.02;
  color: var(--cream);
  margin-bottom: 1.5rem;
}
.witness-quote {
  font-family: var(--serif);
  font-size: 1.15rem;
  line-height: 1.55;
  color: rgba(244,239,227,0.88);
  max-width: 38ch;
  margin-bottom: 2rem;
  padding-bottom: 1.5rem;
  border-bottom: 1px solid rgba(244,239,227,0.18);
}
.witness-attribution .who {
  font-family: var(--display);
  font-size: 1.6rem;
  color: var(--cream);
  margin-bottom: 0.3rem;
}
.witness-attribution .who-meta {
  font-family: var(--mono);
  font-size: 0.66rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: rgba(244,239,227,0.6);
}

/* ============================================================
   PAGE 06 — LA PROJECTION (widget estimation revenus)
   ============================================================ */

.projection { background: var(--cream); }
.projection-grid {
  display: grid;
  grid-template-columns: 1fr 1.4fr;
  gap: 4rem;
  flex: 1;
  align-items: start;
}
.projection-aside {
  position: sticky;
  top: 3rem;
  padding-right: 1rem;
}
.projection-aside h2 {
  font-size: clamp(2.4rem, 4vw, 3.8rem);
  line-height: 0.98;
  margin-bottom: 1.5rem;
}
.projection-aside .deck {
  font-family: var(--serif);
  font-size: 1.08rem;
  color: var(--ink);
  max-width: 38ch;
  margin-bottom: 1.5rem;
  font-weight: 400;
  line-height: 1.6;
}
.projection-aside .projection-note {
  font-family: var(--mono);
  font-size: 0.7rem;
  letter-spacing: 0.12em;
  line-height: 1.7;
  color: var(--mute);
  text-transform: uppercase;
  max-width: 32ch;
  padding-top: 1.2rem;
  border-top: 1px solid var(--rule);
}
.projection-widget-wrap {
  background: transparent;
}
/* On adoucit l'aspect "boîte SaaS" du widget pour qu'il colle au dossier */
.projection-widget-wrap .ew-card {
  background: var(--cream);
  border: 1px solid var(--ink);
  box-shadow: none;
  border-radius: 0;
  padding: 2.5rem 2.2rem;
}
.projection-widget-wrap .ew-h {
  font-family: var(--display) !important;
  font-weight: 400 !important;
  font-size: 2rem !important;
  color: var(--ink) !important;
}
.projection-widget-wrap .ew-sub {
  font-family: var(--serif) !important;
  font-size: 0.95rem !important;
  color: var(--mute) !important;
}
.projection-widget-wrap .ew-step-dot.ew-active span,
.projection-widget-wrap .ew-step-dot.ew-done span {
  background: var(--terra) !important;
}
.projection-widget-wrap .ew-step-dot.ew-active em {
  color: var(--terra) !important;
}
.projection-widget-wrap .ew-step-line.ew-done { background: var(--terra) !important; }
.projection-widget-wrap .ew-btn-primary {
  background: var(--ink) !important;
  border-radius: 0 !important;
  font-family: var(--mono) !important;
  letter-spacing: 0.14em !important;
  text-transform: uppercase !important;
  padding: 14px 22px !important;
}
.projection-widget-wrap .ew-btn-primary:hover { background: var(--terra) !important; }
.projection-widget-wrap .ew-btn-back {
  border-radius: 0 !important;
  font-family: var(--mono) !important;
  letter-spacing: 0.14em !important;
  text-transform: uppercase !important;
}
.projection-widget-wrap .ew-form label > input,
.projection-widget-wrap .ew-form label > select,
.projection-widget-wrap .ew-form label > textarea {
  border-radius: 0 !important;
  border-color: var(--rule) !important;
  background: transparent !important;
}
.projection-widget-wrap .ew-form label > input:focus,
.projection-widget-wrap .ew-form label > select:focus,
.projection-widget-wrap .ew-form label > textarea:focus {
  border-color: var(--terra) !important;
}

/* ============================================================
   PAGE 07 — LES ENGAGEMENTS (Prospectus)
   ============================================================ */

.charter { background: var(--cream); }
.charter-grid {
  display: grid;
  grid-template-columns: 1fr 2fr;
  gap: 4rem;
  flex: 1;
}
.charter-aside {
  position: sticky;
  top: 3rem;
  align-self: start;
}
.charter-aside h2 {
  font-size: clamp(2.4rem, 4vw, 3.8rem);
  line-height: 0.98;
  margin-bottom: 1.5rem;
}
.charter-aside .deck {
  font-size: 1.1rem;
  color: var(--mute);
  max-width: 28ch;
}

.charter-body {
  border-top: 1px solid var(--ink);
}
.charter-clause {
  padding: 2rem 0;
  border-bottom: 1px solid var(--rule);
  display: grid;
  grid-template-columns: 70px 1fr;
  gap: 2rem;
  align-items: baseline;
}
.charter-clause .ref {
  font-family: var(--mono);
  font-size: 0.65rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--mute);
  padding-top: 0.45rem;
}
.charter-clause h3 {
  font-family: var(--display);
  font-size: 1.7rem;
  margin-bottom: 0.5rem;
  line-height: 1.1;
}
.charter-clause p {
  font-family: var(--serif);
  font-size: 1rem;
  line-height: 1.6;
  color: var(--ink);
}

/* ============================================================
   PAGE CARNET — Sommaire des articles de blog
   ============================================================ */

.carnet { background: var(--cream); }
.carnet-head {
  display: grid;
  grid-template-columns: 1fr 1.4fr;
  gap: 4rem;
  margin-bottom: 3.5rem;
}
.carnet-head h2 {
  font-size: clamp(2.4rem, 4.2vw, 4rem);
  line-height: 0.98;
}
.carnet-head p {
  font-family: var(--serif);
  font-size: 1.05rem;
  line-height: 1.55;
  color: var(--ink);
  max-width: 48ch;
}

.carnet-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 0;
  border-top: 2px solid var(--ink);
  border-bottom: 2px solid var(--ink);
}
.carnet-item {
  padding: 1.8rem 2rem;
  border-bottom: 1px solid var(--rule);
  border-right: 1px solid var(--rule);
  text-decoration: none;
  color: var(--ink);
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 1rem;
  align-items: baseline;
  transition: background 0.25s;
}
.carnet-item:nth-child(2n) { border-right: 0; }
.carnet-item:nth-last-child(-n+2) { border-bottom: 0; }
.carnet-item:hover { background: var(--paper); }
.carnet-item:hover .arrow { transform: translateX(4px); color: var(--terra); }

.carnet-item .meta {
  font-family: var(--mono);
  font-size: 0.6rem;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--terra);
  margin-bottom: 0.5rem;
}
.carnet-item h3 {
  font-family: var(--display);
  font-size: 1.35rem;
  line-height: 1.15;
  margin: 0;
}
.carnet-item .arrow {
  font-family: var(--display);
  font-size: 1.5rem;
  color: var(--ink);
  transition: all 0.25s;
  align-self: center;
}

.carnet-foot {
  margin-top: 2.5rem;
  text-align: center;
  font-family: var(--mono);
  font-size: 0.7rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--mute);
}
.carnet-foot a {
  color: var(--ink);
  text-decoration: none;
  border-bottom: 1px solid var(--terra);
  padding-bottom: 2px;
  margin-left: 0.5rem;
}

/* ============================================================
   PAGE 08 — L'INVITATION (CTA pleine page)
   ============================================================ */

.invitation {
  background: var(--terra);
  color: var(--cream);
  text-align: center;
  padding: 5.5rem 0;
  position: relative;
  overflow: hidden;
}
.invitation::before {
  content: '';
  position: absolute;
  inset: 2rem;
  border: 1px solid rgba(244, 239, 227, 0.3);
  pointer-events: none;
}
.invitation::after {
  content: '';
  position: absolute;
  inset: 2.6rem;
  border: 1px solid rgba(244, 239, 227, 0.15);
  pointer-events: none;
}
.invitation .page-inner { align-items: center; text-align: center; }

.invitation-label {
  font-family: var(--mono);
  font-size: 0.7rem;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: rgba(244, 239, 227, 0.7);
  margin-bottom: 2.5rem;
}
.invitation h2 {
  font-size: clamp(3.5rem, 8vw, 8rem);
  line-height: 0.94;
  margin-bottom: 2rem;
  max-width: 14ch;
  margin-left: auto;
  margin-right: auto;
}
.invitation .deck {
  font-size: clamp(1.2rem, 2.2vw, 1.6rem);
  max-width: 38ch;
  margin: 0 auto 4rem;
  color: rgba(244, 239, 227, 0.92);
  font-weight: 300;
}
.invitation-email {
  display: inline-block;
  font-family: var(--display);
  font-size: clamp(1.2rem, 4vw, 3rem);
  color: var(--cream);
  text-decoration: none;
  border-bottom: 1px solid rgba(244, 239, 227, 0.5);
  padding-bottom: 0.4rem;
  transition: border-color 0.25s;
  max-width: 100%;
  word-break: break-word;
  overflow-wrap: anywhere;
}
.invitation-email:hover { border-color: var(--cream); }
.invitation-whatsapp {
  margin-top: 1.5rem;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 0.6rem;
  font-family: var(--mono);
  font-size: 0.75rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: rgba(244, 239, 227, 0.7);
}
.invitation-whatsapp a {
  display: inline-flex;
  align-items: center;
  gap: 0.55rem;
  color: var(--cream);
  text-decoration: none;
  border-bottom: 1px solid rgba(244, 239, 227, 0.4);
  padding-bottom: 2px;
  transition: border-color 0.2s, color 0.2s;
}
.invitation-whatsapp a:hover { border-color: var(--cream); }
.invitation-whatsapp .wa-icon {
  width: 1.1em; height: 1.1em;
  flex-shrink: 0;
}

.invitation-meta {
  margin-top: 2.2rem;
  display: flex;
  justify-content: center;
  gap: 3rem;
  font-family: var(--mono);
  font-size: 0.65rem;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: rgba(244, 239, 227, 0.65);
}
.invitation-sister {
  margin-top: 2.5rem;
  padding-top: 1.5rem;
  border-top: 1px solid rgba(244, 239, 227, 0.18);
  font-family: var(--mono);
  font-size: 0.65rem;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: rgba(244, 239, 227, 0.65);
  max-width: 460px;
  margin-left: auto;
  margin-right: auto;
  white-space: nowrap;
}
.invitation-sister a {
  color: var(--cream);
  text-decoration: none;
  border-bottom: 1px solid rgba(244, 239, 227, 0.4);
  padding-bottom: 1px;
  margin-left: 0.4rem;
  transition: border-color 0.2s;
  white-space: nowrap;
}
.invitation-sister a:hover { border-color: var(--cream); }

/* ============================================================
   COLOPHON — Pied de dossier
   ============================================================ */

.colophon {
  background: var(--ink-deep);
