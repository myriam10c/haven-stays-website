/* ============================================================
   LE DOSSIER — havn stays
   Présenté comme un catalogue d'investissement raffiné.
   Référence : Sotheby's catalog × Phaidon hotels × Maisons Pariente.
   ============================================================ */

:root {
  --sand:        #E8DFCB;   /* sable chaud, fond principal */
  --cream:       #F4EFE3;   /* crème pâle, papier */
  --paper:       #EBE3D0;   /* papier sable plus chaud */
  --ink:         #1C1A17;   /* encre profonde */
  --ink-deep:    #0F0E0B;   /* encre noire */
  --terra:       #A85432;   /* terra cuite, accent rare */
  --gold-soft:   #9A7A3F;   /* or doux, lignes */
  --gold-pale:   rgba(154, 122, 63, 0.32);
  --rule:        rgba(28, 26, 23, 0.22);
  --rule-soft:   rgba(28, 26, 23, 0.10);
  --mute:        rgba(28, 26, 23, 0.62);
  --mute-deep:   rgba(28, 26, 23, 0.45);

  --display:    'Italiana', 'Cormorant Garamond', Georgia, serif;
  --serif:      'Source Serif 4', 'Source Serif Pro', Georgia, serif;
  --sans:       'Inter Tight', 'Inter', system-ui, sans-serif;
  --mono:       'JetBrains Mono', ui-monospace, monospace;
}

* { margin: 0; padding: 0; box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  background: var(--sand);
  color: var(--ink);
  font-family: var(--serif);
  font-weight: 400;
  line-height: 1.6;
  overflow-x: hidden;
  font-feature-settings: "kern", "liga", "onum";
  text-rendering: geometricPrecision;
  -webkit-font-smoothing: antialiased;
  cursor: default;
}

::selection { background: var(--terra); color: var(--cream); }

/* Grain de papier — pseudo-bruit via SVG inline en background */
body::before {
  content: '';
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 1;
  opacity: 0.5;
  background-image: url("data:image/svg+xml;utf8,<svg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='2' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 0.11 0 0 0 0 0.10 0 0 0 0 0.09 0 0 0 0.18 0'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>");
  mix-blend-mode: multiply;
}

main { position: relative; z-index: 2; }

/* ============================================================
   TYPO — HARMONIQUE
   ============================================================ */

h1, h2, h3 {
  font-family: var(--display);
  font-weight: 400;
  line-height: 0.95;
  letter-spacing: 0.005em;
}

em, i { font-style: normal; color: var(--terra); }

.deck {
  font-family: var(--serif);
  font-weight: 400;
  line-height: 1.5;
}

.folio {
  font-family: var(--mono);
  font-size: 0.66rem;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--mute-deep);
}

.section-label {
  font-family: var(--mono);
  font-size: 0.62rem;
  letter-spacing: 0.32em;
  text-transform: uppercase;
  color: var(--mute);
}

.smallcaps {
  font-family: var(--sans);
  font-weight: 500;
  font-size: 0.7rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
}

/* Fleuron entre sections — SVG inline en pseudo */
.fleuron {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 1rem;
  color: var(--gold-soft);
  margin: 2rem 0;
}
.fleuron::before, .fleuron::after {
  content: '';
  width: 60px;
  height: 1px;
  background: currentColor;
  opacity: 0.5;
}

/* ============================================================
   PAGE STRUCTURE — chaque section = une page de dossier
   ============================================================ */

.page {
  position: relative;
  padding: 4.5rem 0 3.5rem;
  display: flex;
  flex-direction: column;
}
.page-inner {
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 3rem;
  width: 100%;
  display: flex;
  flex-direction: column;
}

/* En-tête de chaque page : étiquette section + folio */
.page-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding-bottom: 0.6rem;
  border-bottom: 1px solid var(--ink);
  margin-bottom: 2.5rem;
}

/* Pied de page de chaque section : numéro de page + ligne marque */
.page-foot {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding-top: 1.5rem;
  margin-top: 3rem;
  border-top: 1px solid var(--rule-soft);
  font-family: var(--mono);
  font-size: 0.62rem;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--mute-deep);
}
.page-foot .ornament {
  width: 8px; height: 8px;
  background: var(--ink);
  border-radius: 50%;
  display: inline-block;
  margin: 0 1rem;
  vertical-align: middle;
}

/* ============================================================
   PAGE 01 — COUVERTURE
   ============================================================ */

.cover {
  background: var(--ink-deep);
  color: var(--cream);
  padding: 0;
  min-height: 92vh;
  position: relative;
  overflow: hidden;
}
.cover-video {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  z-index: 0;
  filter: brightness(0.5) contrast(1.05) saturate(0.85);
}
.cover-overlay {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(180deg, rgba(15,14,11,0.4) 0%, transparent 25%, rgba(15,14,11,0.7) 90%),
    radial-gradient(ellipse at center top, rgba(168,84,50,0.12), transparent 60%);
  z-index: 1;
}

.cover-content {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 100vh;
  padding: 2.5rem 3rem;
}

.cover-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  color: rgba(244, 239, 227, 0.7);
}
.cover-top .right {
  text-align: right;
}
.cover-top-cta {
  display: inline-block;
  padding: 0.65rem 1.2rem;
  background: var(--cream);
  color: var(--ink);
  font-family: var(--mono);
  font-size: 0.68rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  text-decoration: none;
  border: 1px solid var(--cream);
  transition: all 0.25s;
}
.cover-top-cta:hover {
  background: var(--terra);
  color: var(--cream);
  border-color: var(--terra);
}
.cover-top .left .loc {
  font-family: var(--mono);
  font-size: 0.65rem;
  letter-spacing: 0.32em;
  text-transform: uppercase;
  color: var(--terra);
}

.cover-center {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 1.5rem;
  margin: auto 0;
  max-width: 1100px;
}
.cover-imprint {
  font-family: var(--mono);
  font-size: 0.7rem;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: rgba(244, 239, 227, 0.6);
}
.cover-title {
  font-family: var(--display);
  font-size: clamp(4rem, 13vw, 14rem);
  line-height: 0.84;
  font-weight: 400;
  letter-spacing: -0.005em;
  color: var(--cream);
  margin-bottom: 0.5rem;
}
.cover-pitch {
  font-family: var(--serif);
  font-size: clamp(1.25rem, 2.1vw, 1.8rem);
  font-weight: 400;
  color: var(--cream);
  max-width: 44ch;
  line-height: 1.35;
  margin-top: -0.5rem;
}

.cover-bullets {
  list-style: none;
  margin-top: 2.2rem;
  display: grid;
  gap: 0.6rem;
  max-width: 620px;
}
.cover-bullets li {
  display: grid;
  grid-template-columns: 36px 1fr;
  gap: 1rem;
  align-items: baseline;
  padding: 0.7rem 0;
  border-top: 1px solid rgba(244,239,227,0.18);
}
.cover-bullets li:last-child { border-bottom: 1px solid rgba(244,239,227,0.18); }
.cover-bullets .b-num {
  font-family: var(--mono);
  font-size: 0.7rem;
  letter-spacing: 0.22em;
  color: var(--terra);
}
.cover-bullets .b-text {
  font-family: var(--serif);
  font-size: 1rem;
  color: rgba(244,239,227,0.92);
  line-height: 1.4;
}

a.cover-cta {
  display: inline-block;
  margin-top: 2.2rem;
  padding: 1rem 1.8rem;
  background: var(--cream);
  color: var(--ink);
  text-decoration: none;
  font-family: var(--mono);
  font-size: 0.78rem;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  border: 1px solid var(--cream);
  transition: all 0.25s;
}
a.cover-cta:hover {
  background: var(--terra);
  color: var(--cream);
  border-color: var(--terra);
}

.cover-bottom {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  gap: 2rem;
  align-items: end;
  font-family: var(--mono);
  font-size: 0.62rem;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: rgba(244, 239, 227, 0.6);
}
.cover-bottom .scroll-hint {
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.6rem;
}
.cover-bottom .scroll-hint .arrow {
  width: 1px;
  height: 36px;
  background: rgba(244, 239, 227, 0.6);
  animation: pulse-down 2.2s infinite ease-in-out;
}
@keyframes pulse-down {
  0%, 100% { transform: translateY(0); opacity: 0.4; }
  50% { transform: translateY(8px); opacity: 1; }
}
.cover-bottom .right { text-align: right; }

/* ============================================================
   PAGE 02 — AVANT-PROPOS
   ============================================================ */

.foreword {
  background: var(--paper);
  text-align: center;
}
.foreword .page-inner {
  align-items: center;
  text-align: center;
}
.foreword-text {
  font-family: var(--serif);
  font-size: clamp(1.4rem, 2.6vw, 2rem);
  line-height: 1.45;
  max-width: 34ch;
  font-weight: 400;
  color: var(--ink);
}
.foreword-text em {
  font-style: normal;
  color: var(--terra);
}
.foreword-attribution {
  margin-top: 3rem;
  font-family: var(--mono);
  font-size: 0.7rem;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--mute);
  display: flex;
  align-items: center;
  gap: 1rem;
}
.foreword-attribution::before, .foreword-attribution::after {
  content: '';
  width: 32px;
  height: 1px;
  background: currentColor;
  opacity: 0.5;
}

/* ============================================================
   PAGE 03 — L'OPÉRATEUR (Portrait Hillal)
   ============================================================ */

.operator {
  background: var(--sand);
}
.operator-grid {
  display: grid;
  grid-template-columns: 5fr 6fr;
  gap: 5rem;
  align-items: stretch;
  flex: 1;
}
.operator-portrait {
  position: relative;
  aspect-ratio: 4 / 5;
  background: var(--ink-deep);
  overflow: hidden;
}
.operator-portrait img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  filter: contrast(1.04) saturate(0.92) grayscale(0.15);
}
.operator-portrait::after {
  content: '';
  position: absolute;
  inset: 0;
  border: 1px solid var(--ink);
  outline: 1px solid var(--ink);
  outline-offset: -12px;
  pointer-events: none;
}
.operator-portrait .caption {
  position: absolute;
  bottom: -2.2rem;
  left: 0;
  font-family: var(--mono);
  font-size: 0.62rem;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--mute);
}

.operator-text { display: flex; flex-direction: column; justify-content: center; }
.operator-name {
  font-family: var(--display);
  font-size: clamp(2.4rem, 4.2vw, 4rem);
  line-height: 0.95;
  margin-bottom: 0.4rem;
}
.operator-role {
  font-family: var(--mono);
  font-size: 0.72rem;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--mute);
  margin-bottom: 2.5rem;
  padding-bottom: 1.5rem;
  border-bottom: 1px solid var(--rule);
}
.operator-text p {
  font-family: var(--serif);
  font-size: 1.08rem;
  line-height: 1.65;
  max-width: 48ch;
  margin-bottom: 1.1rem;
  font-weight: 400;
}
.operator-pitch {
  font-size: 1.15rem !important;
  margin-bottom: 2rem !important;
  padding-bottom: 1.5rem;
  border-bottom: 1px solid var(--rule-soft);
}
.method-list {
  list-style: none;
  margin-bottom: 2rem;
  display: grid;
  gap: 0;
}
.method-list li {
  display: grid;
  grid-template-columns: 44px 1fr;
  gap: 1rem;
  align-items: baseline;
  padding: 0.75rem 0;
  border-bottom: 1px solid var(--rule-soft);
}
.method-list li:first-child { border-top: 1px solid var(--rule-soft); }
.method-list .m-num {
  font-family: var(--mono);
  font-size: 0.7rem;
  letter-spacing: 0.18em;
  color: var(--terra);
}
.method-list .m-text {
  font-family: var(--serif);
  font-size: 1rem;
  color: var(--ink);
  line-height: 1.4;
}
.operator-cv {
  margin-top: 2rem;
  padding-top: 1.5rem;
  border-top: 1px solid var(--rule);
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 1.5rem;
}
.operator-cv > div .label {
  font-family: var(--mono);
  font-size: 0.62rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--mute);
  margin-bottom: 0.4rem;
}
.operator-cv > div .value {
  font-family: var(--display);
  font-size: 1.3rem;
  line-height: 1.1;
}

/* ============================================================
   PAGE 04 — LA MÉTHODE (Typographie large)
   ============================================================ */

.method {
  background: var(--cream);
  padding: 8rem 0;
}
.method-statements {
  display: flex;
  flex-direction: column;
  gap: 0;
  max-width: 1100px;
  margin: 0 auto;
}
.method-statement {
  padding: 3rem 0;
  border-bottom: 1px solid var(--rule);
  display: grid;
  grid-template-columns: 80px 1fr;
  gap: 2rem;
  align-items: baseline;
}
.method-statement:last-child { border-bottom: 0; }
.method-statement .num {
  font-family: var(--mono);
  font-size: 0.7rem;
  letter-spacing: 0.22em;
  color: var(--mute);
  padding-top: 0.6rem;
}
.method-statement .text {
  font-family: var(--display);
  font-size: clamp(1.8rem, 3.5vw, 3.2rem);
  line-height: 1.1;
  font-weight: 400;
}
.method-statement .text em {
  font-family: var(--serif);
  font-style: normal;
  color: var(--terra);
}
.method-statement .note {
  font-family: var(--serif);
  font-size: 1rem;
  color: var(--mute);
  margin-top: 0.8rem;
  line-height: 1.6;
  max-width: 58ch;
  grid-column: 2;
}

/* ============================================================
   PAGE 05 — LE PORTEFEUILLE (Image hero + index marginal)
   ============================================================ */

.portfolio {
  background: var(--ink-deep);
  color: var(--cream);
  padding: 0;
  min-height: 100vh;
  position: relative;
  display: flex;
  align-items: stretch;
}
.portfolio::before { display: none; }
.portfolio-image {
  flex: 0 0 60%;
  background-image: url('/hero-poster.jpg');
  background-size: cover;
  background-position: center;
  position: relative;
}
.portfolio-image::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, transparent 0%, transparent 60%, var(--ink-deep) 100%);
}
.portfolio-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 3rem 3rem 2.5rem 2rem;
}
.portfolio-head {
  display: flex;
  justify-content: space-between;
  font-family: var(--mono);
  font-size: 0.62rem;
  letter-spacing: 0.28em;
  text-transform: uppercase;
  color: rgba(244, 239, 227, 0.55);
  padding-bottom: 0.6rem;
  border-bottom: 1px solid rgba(244, 239, 227, 0.2);
}
.portfolio-title {
  font-family: var(--display);
  font-size: clamp(2.6rem, 5.5vw, 5.4rem);
